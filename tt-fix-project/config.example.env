# Copy this file to .env and fill in your real TT SIM/UAT values.
# .env is gitignored - never commit real credentials.

SENDER_COMP_ID=YOUR_SENDER_COMP_ID
TARGET_COMP_ID=TT
TT_USERNAME=YOUR_USERNAME
TT_PASSWORD=YOUR_PASSWORD
HOST=fix-uat.tradingtechnologies.example.com
PORT=12345
FIX_VERSION=FIX.4.4
HEARTBEAT_INTERVAL=30

# CME futures use a continuous-contract style symbol in many FIX setups,
# e.g. ES for E-mini S&P 500. Confirm the exact symbol format TT expects -
# it may need month/year codes instead (e.g. ESZ6).
DEFAULT_SYMBOL=ES
